# ⚠️ IMPORTANT: DO NOT COMMIT THIS FILE TO GIT
# Copy this to secrets.toml and add your actual secrets
# File location: ~/.streamlit/secrets.toml

# Example: API Keys
# api_key = "your_api_key_here"
# database_url = "postgresql://user:password@localhost/dbname"

# Example: Database Connection
# db_host = "localhost"
# db_port = 5432
# db_user = "admin"
# db_password = "secure_password"

# Example: Authentication
# auth_token = "your_auth_token"
# secret_key = "your_secret_key"

# Note: In Streamlit Cloud, add secrets via:
# App settings → Secrets → Add secret
